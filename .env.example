# Copy to .env for local runs. Never commit the real file.
IG_USER_ID=
IG_ACCESS_TOKEN=

# Public HTTPS address that serves this repository's files.
# Not needed inside GitHub Actions on a public repository.
PUBLIC_BASE_URL=

# Optional
# IG_API_BASE=https://graph.facebook.com     # or https://graph.instagram.com
# IG_API_VERSION=v24.0
# ANTHROPIC_API_KEY=            # AI captions
# FB_PAGE_ID=                   # cross-post to a Facebook Page
# FB_PAGE_ACCESS_TOKEN=
# THREADS_USER_ID=              # cross-post to Threads
# THREADS_ACCESS_TOKEN=
# FB_APP_ID=                    # token refresh (Facebook Login tokens)
# FB_APP_SECRET=
# TELEGRAM_BOT_TOKEN=           # alerts by Telegram
# TELEGRAM_CHAT_ID=
